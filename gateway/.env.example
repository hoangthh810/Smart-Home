# Sao chép thành .env rồi điền (không commit file .env và file khoá service account)
# Khoá service account: Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_CREDENTIALS=service-account.json
# Firebase Console → Realtime Database → URL ở đầu trang dữ liệu
FIREBASE_DB_URL=https://smart-home-9efb8-default-rtdb.asia-southeast1.firebasedatabase.app

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=smarthome
MQTT_PASS=

# Gmail gửi cảnh báo gas: bật xác minh 2 bước → myaccount.google.com/apppasswords → tạo mật khẩu ứng dụng (16 ký tự, bỏ dấu cách)
GMAIL_USER=
GMAIL_APP_PASSWORD=
