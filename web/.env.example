# Sao chép thành .env.local rồi điền giá trị (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database (dữ liệu cảm biến thật qua Pi). Để trống → web dùng dữ liệu giả lập
VITE_FIREBASE_DATABASE_URL=
# Đặt = mock để ép dùng giả lập dù đã có Realtime Database
VITE_REALTIME=
VITE_BOOTSTRAP_ADMIN_UID=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
